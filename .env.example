# Copy to .env and replace the placeholders with unique random secrets.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
MAX_RECIPIENTS_PER_JOB=1000
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=300
# Optional Gmail delivery. Use a Google App Password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_APP_PASSWORD=
SMTP_FROM_EMAIL=
